services:
  # Redis Cache (Port 6379)
  redis:
    image: redis:7-alpine
    container_name: midas-redis
    command: redis-server --maxmemory 512mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 3
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 768M
        reservations:
          memory: 512M
    networks:
      - midas-network

  # Backend Agent API (Port 8000)
  backend-agent:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: midas-backend-agent
    env_file:
      - ./.env.docker
      - ./backend/.env
    environment:
      API_HOST: "0.0.0.0"
      API_PORT: "8000"
      PORT: "8000"
      CORS_ORIGINS: "http://localhost,http://localhost:3000"
      REDIS_URL: "${REDIS_URL:-redis://redis:6379}"  # Optional via env
      USE_SUPABASE_STORAGE: "true"  # All uploads to Supabase
    # NO VOLUMES - Stateless (logs to stdout, models in image, uploads to Supabase)
    depends_on:
      redis:
        condition: service_started  # Don't block on health check
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health').read()\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 4G
          cpus: '2.0'
        reservations:
          memory: 2G
          cpus: '1.0'
    networks:
      - midas-network

  # Frontend (Port 3000)
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: midas-frontend
    environment:
      NEXT_PUBLIC_BACKEND_URL: "/api/v1"
      NEXT_PUBLIC_API_URL: "/api/v1"
      BACKEND_URL: "http://backend-agent:8000"
      NODE_ENV: "production"
      NEXT_TELEMETRY_DISABLED: "1"
      PORT: "3000"
    env_file:
      - ./.env.docker
    depends_on:
      backend-agent:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})\""]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: '1.0'
        reservations:
          memory: 512M
          cpus: '0.5'
    networks:
      - midas-network

  # Nginx reverse proxy (single public entrypoint)
  nginx:
    image: nginx:1.27-alpine
    container_name: midas-nginx
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      # NO log volume - use docker logs
    depends_on:
      frontend:
        condition: service_healthy
      backend-agent:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: '0.5'
        reservations:
          memory: 128M
          cpus: '0.25'
    networks:
      - midas-network

  # Monitoring services moved to docker-compose.monitoring.yml
  # Run separately: docker-compose -f docker-compose.monitoring.yml up -d

networks:
  midas-network:
    driver: bridge

# NO VOLUMES - Stateless architecture
# All persistent state lives in Supabase (Postgres + Storage + Edge Functions)
volumes:
  redis_data:  # Keep for local dev convenience only
    driver: local
